{
  "name": "@byo-oss/notifications",
  "version": "0.11.2",
  "description": "In-app notifications for better-auth apps. One plugin, one migration, one component — notifications live in your database, addressed to your users.",
  "license": "MIT",
  "author": "Jarod Stewart",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./wraps": {
      "types": "./dist/wraps.d.ts",
      "import": "./dist/wraps.js",
      "require": "./dist/wraps.cjs"
    },
    "./mailer": {
      "types": "./dist/mailer.d.ts",
      "import": "./dist/mailer.js",
      "require": "./dist/mailer.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": ["dist", "README.md", "llms.txt", "skills"],
  "scripts": {
    "build": "rm -rf dist && tsup && node -e \"['index.d.ts','client.d.ts','wraps.d.ts','mailer.d.ts','testing.d.ts','react/index.d.ts','react/index.js','index.js','client.js','wraps.js','mailer.js','testing.js'].forEach(f => require('fs').accessSync('dist/' + f))\"",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["better-auth", "byo", "notifications", "inbox", "in-app", "react", "plugin"],
  "repository": {
    "type": "git",
    "url": "https://github.com/byo-oss/notifications"
  },
  "homepage": "https://github.com/byo-oss/notifications#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@better-auth/core": "^1.7.7",
    "@wraps.dev/email": ">=0.15.1",
    "better-auth": "^1.7.7",
    "react": ">=18",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@wraps.dev/email": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@byo-oss/core": "^0.1.0",
    "@byo-oss/mailer": "^0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/memory-adapter": "1.7.7",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wraps.dev/email": "^0.15.1",
    "better-auth": "1.7.7",
    "happy-dom": "^20.10.6",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9",
    "vitest": "^4.1.10"
  }
}
